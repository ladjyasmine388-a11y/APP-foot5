# Configuration de PRODUCTION (docker/compose.prod.yml). Copier en `.env.production`, remplir TOUT, ne JAMAIS le committer.
# L'API valide cette configuration au démarrage et REFUSE de démarrer si une valeur dangereuse subsiste (voir docs/SECURITY.md).

# ───────── Adresses ─────────
# UNE seule adresse publique (https). Le site relaie /api vers l'API : WEB_ORIGIN et API_PUBLIC_URL sont identiques.
WEB_ORIGIN=https://footfive.example.dz
API_PUBLIC_URL=https://footfive.example.dz
# WEB_PORT=80

# ───────── Base de données ─────────
# Mot de passe du rôle PostgreSQL « footfive » (compose en déduit DATABASE_URL). Long et aléatoire.
POSTGRES_PASSWORD=

# ───────── Authentification ─────────
# Au moins 32 caractères aléatoires, propres à cet environnement. Exemple de génération : openssl rand -base64 48
JWT_ACCESS_SECRET=
# JWT_ACCESS_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30

# ───────── Paiement ─────────
# Le paiement simulé (fake) est INTERDIT en production. « live » exige l'adaptateur CIB/Edahabia, pas encore écrit :
# tant qu'il n'existe pas, l'API refuse de démarrer en production (voir docs/PAYMENTS.md, section « Brancher CIB / Edahabia »).
PAYMENT_PROVIDER=live
# Secret de signature des webhooks, fourni par le prestataire (16 caractères minimum).
PAYMENT_WEBHOOK_SECRET=

# ───────── Emails ─────────
# Le driver « console » est interdit en production.
MAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=true        # TLS implicite (port 465). Sinon STARTTLS est exigé.
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Foot Five <no-reply@footfive.example.dz>"

# ───────── Fichiers envoyés (avatars, logos, photos) ─────────
# Disque local (volume Docker « uploads ») : convient à UNE seule instance de l'API. L'adaptateur S3 n'est pas encore écrit.
STORAGE_DRIVER=local

# ───────── Divers ─────────
# GLOBAL_RATE_LIMIT_PER_MINUTE=300
# OPENAPI_ENABLED=false   # documentation interactive /api/docs : désactivée en production par défaut
