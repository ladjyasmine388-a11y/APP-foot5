# ───────── Application ─────────
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
# Adresse publique de l'API (pages de paiement du prestataire simulé). Défaut : http://localhost:<API_PORT>
# API_PUBLIC_URL=http://localhost:3000

# ───────── Base de données ─────────
# Docker Compose : port 5433.  PostgreSQL installé sur la machine : port 5432 (voir scripts/db/setup-local.sql).
POSTGRES_USER=footfive
POSTGRES_PASSWORD=footfive_dev_password
POSTGRES_DB=footfive
POSTGRES_PORT=5433
DATABASE_URL=postgresql://footfive:footfive_dev_password@localhost:5433/footfive
TEST_DATABASE_URL=postgresql://footfive:footfive_dev_password@localhost:5433/footfive_test

# ───────── Authentification (CHANGER en production, >= 32 caractères aléatoires) ─────────
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ───────── Réservation ─────────
BOOKING_HOLD_MINUTES=10

# ───────── Paiement ─────────
# fake = fournisseur simulé (INTERDIT en production, le démarrage échoue)
PAYMENT_PROVIDER=fake
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret-change-me

# ───────── Email (Mailpit en dev) ─────────
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_SECURE=true        # TLS implicite (port 465) ; sinon STARTTLS (exigé en production)
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_DRIVER=smtp      # console (dev) | smtp ; « console » est interdit en production
MAIL_FROM="Foot Five <no-reply@footfive.local>"

# ───────── Stockage (local en dev, S3/MinIO ensuite) ─────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=footfive
S3_ACCESS_KEY=footfive
S3_SECRET_KEY=footfive_dev_secret
