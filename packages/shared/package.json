{
  "name": "@footfive/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Types, enums et schémas Zod partagés entre l'API, le web et le futur mobile",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@footfive/config": "workspace:*",
    "eslint": "^10.12.0",
    "tsup": "^8.5.1",
    "vitest": "^5.0.3"
  }
}
