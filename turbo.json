{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "lint": {
      "dependsOn": ["^build", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "generate"]
    },
    "dev": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "persistent": true
    },
    "generate": {
      "outputs": ["src/generated/**"],
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"]
    }
  },
  "globalPassThroughEnv": ["SWC_NATIVE_BINDING_CACHE"],
  "agentGuidance": false
}
