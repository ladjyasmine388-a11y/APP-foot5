    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@footfive/config": "workspace:*",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.2",
    "@swc/core": "^1.16.13",
    "@types/node": "^26.6.4",
